{
  "name": "qqsg-fighting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/phase1/*.test.ts tests/phase2/*.test.ts tests/phase2/*.test.mjs",
    "test:phase1": "tsx --test tests/phase1/*.test.ts",
    "test:phase2": "tsx --test tests/phase2/*.test.ts tests/phase2/*.test.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "fake-indexeddb": "6.2.4",
    "playwright-core": "1.65.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
